# Supabase project settings (Project Settings > API in Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL the browser prefixes onto /api calls. Leave it EMPTY — the app and
# the functions share an origin on Vercel, and an empty value means "same
# origin", which is what you want in both dev and production.
#
# Do not put your deployment URL here to develop against it: nothing under api/
# sends CORS headers, so the browser blocks every cross-origin call. Set
# DEV_API_PROXY below instead.
VITE_API_BASE_URL=

# Optional placeholder shown in the header before the first scan arrives. The
# real project name travels with the scan, so this no longer has to be kept in
# step with the add-in's "Project name" by hand.
VITE_PROJECT_NAME=HBE-ELECTRICAL-E

# Optional, dev only: run the frontend locally against a DEPLOYED backend.
# Vite proxies /api there, so the browser stays same-origin and CORS never
# applies. Leave unset when running `vercel dev`, which serves api/ locally.
# DEV_API_PROXY=https://your-deployment.vercel.app

# --- Server-side only -------------------------------------------------------
# Read by the functions under api/. Set these in Vercel for deployed
# environments; they are only needed here to run `vercel dev` locally. Anything
# without a VITE_ prefix is never bundled into the frontend — keep it that way,
# because each of these bypasses row-level security.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# OPTIONAL fallback add-in key. Normally you do not need this: add-in keys are
# generated per user in the web app under "API Keys", which makes them
# revocable and scoped to one account. Set this only for an install with no
# account behind it (a shared workstation image, a smoke test).
# Generate with: openssl rand -hex 32
# ADDIN_API_KEY=

# Supabase project settings (Project Settings > API in Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed backend (Vercel deployment or http://localhost:5173 in dev)
VITE_API_BASE_URL=https://cable-tray-hanger.vercel.app

# Optional: default Revit project name shown in the UI
VITE_PROJECT_NAME=HBE-ELECTRICAL-E

# --- Server-side only -------------------------------------------------------
# Read by the functions under api/. Set these in Vercel for deployed
# environments; they are only needed here to run `vercel dev` locally. Anything
# without a VITE_ prefix is never bundled into the frontend — keep it that way,
# because each of these bypasses row-level security.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# OPTIONAL fallback add-in key. Normally you do not need this: add-in keys are
# generated per user in the web app under "API Keys", which makes them
# revocable and scoped to one account. Set this only for an install with no
# account behind it (a shared workstation image, a smoke test).
# Generate with: openssl rand -hex 32
# ADDIN_API_KEY=
